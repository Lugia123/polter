      "macos/Sources/Features/ControlRoom/ControlRoomStartChoice.swift",
      "macos/Sources/Features/ControlRoom/ControlRoomSupervisorFrame.swift",
      "macos/Sources/Features/ControlRoom/ControlRoomView.swift",
      "macos/Sources/Features/ControlRoom/PaneFrame.swift",
      "macos/Sources/Features/ControlRoom/ControlRoomWindowSize.swift",
      "macos/Sources/Features/ControlRoom/PaneFrameView.swift",
      "macos/Sources/Features/ControlRoom/PaneStackStrip.swift",
