    "out": [
      {
        "path": "macos/Tests/Projects/ProjectRestartTests.swift",
        "why": "imports GhosttyKit and starts real terminals: it is about a pane's snapshot surviving a restart of the app"
      },
      {
        "path": "macos/Tests/Projects/ProjectSaveBeforeCloseTests.swift",
        "why": "about ProjectSaveBeforeClose.swift, which puts an alert on a window"
      },
      {
        "path": "macos/Tests/Projects/ProjectScrollbackTests.swift",
        "why": "imports GhosttyKit: half of it asks the core to write and read a snapshot"
      },
      {
        "path": "macos/Tests/Projects/ProjectStoreSettingsTests.swift",
        "why": "about ProjectStore, which holds the core's app and saves live terminals (ProjectStore.swift imports GhosttyKit)"
      },
