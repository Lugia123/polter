      "macos/Sources/Features/ControlRoom/TerminalPresence.swift",
      "macos/Sources/Features/Splits/SplitTree.swift",
      "macos/Sources/Features/Splits/SurfaceDragGrip.swift",
      "macos/Sources/Helpers/Backport.swift",
      "macos/Sources/Helpers/Extensions/Array+Extension.swift",
      "macos/Sources/Features/Terminal/TabAccessory.swift",
      {
        "path": "macos/Sources/Features/Splits/PoltergeistLayoutShape.swift",
        "until": "extension SplitTree<Ghostty.SurfaceView>.Node {",
        "why": "the parser and the shape are taken; what follows the marker reads a real terminal's surface handle"
      },
      {
        "path": "macos/Sources/Features/Splits/TerminalSplitTreeView.swift",
        "from": "enum TerminalSplitDropZone: String, Equatable {",
        "prepend": [
          "import SwiftUI"
        ],
        "why": "only the drop zone's arithmetic, which is the end of the file; the views before it hold live terminals"
      },
      "macos/Sources/Features/Projects/ProjectScrollback.swift",
      {
        "path": "macos/Sources/Features/Projects/ProjectDocument.swift",
        "until": "// MARK: - Capture",
        "drop": [
          "import GhosttyKit"
        ],
        "why": "the document's writing and reading are taken, which is what the files in test/project-format are checked against; from the marker on it captures live terminals"
      },
      "macos/Sources/Features/Projects/ProjectAutosave.swift",
      "macos/Sources/Features/Projects/ProjectFilename.swift",
      "macos/Sources/Features/Projects/ProjectLink.swift",
      "macos/Sources/Features/Projects/ProjectPageRules.swift",
      "macos/Sources/Features/Projects/ProjectPages.swift"
    ],
    "out": [
      {
        "path": "macos/Sources/Features/ControlRoom/ControlRoomController.swift",
        "why": "imports GhosttyKit: it is the window controller, and holds the core's app and the terminals' views"
      },
      {
        "path": "macos/Sources/Features/ControlRoom/ControlRoomLender.swift",
        "why": "imports GhosttyKit: it moves a real terminal view between windows"
      },
      {
        "path": "macos/Sources/Features/ControlRoom/PaneFrameSplit.swift",
        "why": "needs Ghostty.App, the real SurfaceView and BaseTerminalController: it is where a frame is put round a live pane. The frame itself (PaneFrameView.swift) and the rule for which frame (PaneFrame.swift) are in"
      }
    ]
  },
  "tests": {
