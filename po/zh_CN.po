#: windows/host/src/personas.rs:335
msgid "Switched off by hand"
msgstr "手动关掉的"

# Our gap, not the agent's. The reader should go and check the path, not go and install something.
#: windows/host/src/personas.rs:416
msgid "Nobody has checked where this agent keeps these yet"
msgstr "还没有人核实过这家 agent 把它们放在哪"

