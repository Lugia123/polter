msgstr "Przeskocz do następnego wyniku wyszukiwania (jeśli taki jest)."

#: src/input/command.zig:219
msgid "Previous Search Result"
msgstr "Poprzedni wynik wyszukiwania"

#: src/input/command.zig:220
msgid "Navigate to the previous search result, if any."
msgstr "Przeskocz do poprzedniego wyniku wyszukiwania (jeśli taki jest)."

