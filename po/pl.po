msgstr "Rozpocznij wyszukiwanie (jeśli nie jest już aktywne)."

#: src/input/command.zig:203
msgid "Search Selection"
msgstr "Szukaj zaznaczenia"

#: src/input/command.zig:204
msgid "Start a search for the current text selection."
msgstr "Rozpocznij wyszukiwanie obecnie zaznaczonego tekstu."

#: src/input/command.zig:209
msgid "End Search"
msgstr "Zakończ wyszukiwanie"

#: src/input/command.zig:210
msgid "End the current search if any and hide any GUI elements."
msgstr ""
"Zakończ obecne wyszukiwanie (jeśli trwa) i ukryj wszelkie elementy GUI."

