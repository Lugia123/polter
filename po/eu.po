msgstr "Kopiatu arbelera terminalaren izenburua"

#: src/input/command.zig:180
msgid ""
"Copy the terminal title to the clipboard. If the terminal title is not set "
"this has no effect."
msgstr ""
"Kopiatu arbelera terminalaren izenburua. Izenburua ezarri gabe badago ez du "
"ezer egingo."

#: src/input/command.zig:185
msgid "Paste from Clipboard"
