#: src/input/command.zig:237 windows/host/src/menu.rs:290
msgid "Reset Font Size"
msgstr "Redefinir tamanho da fonte"

#: src/input/command.zig:238
msgid "Reset the font size to the default."
msgstr "Redefinir o tamanho da fonte para o padrão."

#: src/input/command.zig:243
